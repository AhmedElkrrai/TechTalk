                        {
                            "answerText": "Domain layer",
                            "isCorrect": true
                        },
                        {
                            "answerText": "UI theme layer",
                            "isCorrect": false
                        }
                    ]
                },
                {
                    "questionText": "What dependency rule does Clean Architecture enforce?",
                    "difficulty": "ADVANCED",
                    "explanation": "Dependencies point inward: outer layers depend on abstractions in inner layers, not the other way around.",
                    "answers": [
                        {
                            "answerText": "All layers should depend directly on framework classes",
                            "isCorrect": false
                        },
                        {
                            "answerText": "Data layer must import UI composables",
                            "isCorrect": false
                        },
                        {
                            "answerText": "Outer layers can depend on inner layers, but inner layers must not depend on outer layers",
                            "isCorrect": true
                        },
                        {
                            "answerText": "Domain layer should call Android Context APIs directly",
                            "isCorrect": false
                        }
                    ]
                }
